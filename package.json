{
  "name": "@xagt/agent-plugin",
  "version": "0.4.0",
  "description": "X-Agent skill installer for Codex, Claude Code, Cursor, OpenCode, and AgentSkills-compatible runtimes.",
  "type": "module",
  "bin": {
    "xagt-plugin": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    ".cursor-plugin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "validate:submission": "node scripts/validate-submission.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "xagt",
    "xagent",
    "agent",
    "skills",
    "plugin"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
