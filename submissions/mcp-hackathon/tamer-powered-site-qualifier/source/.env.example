# Local x402 service configuration. Never commit a real .env file.
X402_MODE=mock
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
X402_ASSET=0.0.0
X402_AMOUNT=100000
X402_MAX_TIMEOUT_SECONDS=300
X402_PAY_TO=0.0.REPLACE_WITH_SELLER_TESTNET_ACCOUNT
X402_FEE_PAYER=0.0.REPLACE_WITH_BLOCKY402_FEE_PAYER
X402_RESOURCE_URL=http://127.0.0.1:8787/v1/paid/qualify

# Consuming agent only; set only after explicit approval and testnet account creation.
SERVICE_URL=http://127.0.0.1:8787/v1/paid/qualify
HEDERA_CLIENT_ACCOUNT_ID=0.0.REPLACE_WITH_BUYER_TESTNET_ACCOUNT
HEDERA_CLIENT_PRIVATE_KEY=REPLACE_WITH_ECDSA_TESTNET_PRIVATE_KEY
