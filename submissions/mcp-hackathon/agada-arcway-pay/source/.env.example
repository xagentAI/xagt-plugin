# -----------------------------------------------------------------------------
# Privy (auth + embedded wallets) — https://dashboard.privy.io
# -----------------------------------------------------------------------------
# Public App ID, safe to expose to the browser. Used by @privy-io/react-auth
# on the client to render the login flow. Required for real sign-in; without
# it the app runs in a click-through "demo dashboard" mode with no auth.
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-only secret, used by @privy-io/server-auth (lib/privy.ts) to
# provision embedded wallets for payees by email. NEVER expose this to the
# client or commit it — keep it in .env.local only.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# -----------------------------------------------------------------------------
# Circle Developer-Controlled Wallets / Arc — https://console.circle.com
# -----------------------------------------------------------------------------
# Sandbox API key from the Circle Developer Console.
CIRCLE_API_KEY=

# Entity secret used to authorize wallet operations (generated once via
# Circle's entity secret setup flow / SDK — see lib/circle.ts for details).
CIRCLE_ENTITY_SECRET=

# The id of the developer-controlled "treasury" wallet payouts are sent
# from. Create one in the Circle console and fund it with sandbox USDC.
CIRCLE_TREASURY_WALLET_ID=

# -----------------------------------------------------------------------------
# Mock mode
# -----------------------------------------------------------------------------
# Leave every variable above blank to run the whole app in mock mode: Privy
# login is skipped in favor of a demo dashboard link, embedded wallet
# addresses are deterministically generated, and Circle transfers are
# simulated with realistic delays and an occasional simulated failure. This
# is the default and lets `npm run dev` work with zero setup.

# -----------------------------------------------------------------------------
# Email notifications (Resend — https://resend.com)
# -----------------------------------------------------------------------------
# Both must be set to send real mail. Without them the app runs in email mock
# mode: messages are rendered, logged, written to .mock-emails/, and viewable
# at /dev/emails — never silently dropped.
RESEND_API_KEY=
RESEND_FROM=

# Absolute base URL used to build claim links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# On-chain balance reads (payee /claim page)
# -----------------------------------------------------------------------------
# Both must be set — AND Circle must be live — for /claim to read a real
# on-chain balance. Otherwise the balance is derived from the payout ledger and
# labelled "simulated", which is the truthful answer when no payout has
# actually touched a chain.
#
# Verified values for Arc testnet (ARC-TESTNET), the network this project runs on:
#   USDC_RPC_URL=https://rpc.testnet.arc.network
#   USDC_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000
# Arc reports USDC twice — native (18dp) and ERC-20 (6dp). They are one
# balance viewed two ways; use the ERC-20 address above, whose 6 decimals
# match the schema's Decimal(20, 6).
USDC_RPC_URL=
USDC_TOKEN_ADDRESS=
