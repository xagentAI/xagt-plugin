# Required for `npm install` to succeed at all — see README, "Dependency notes".
#
# @circle-fin/developer-controlled-wallets declares a peerOptional on
# @solana/codecs-strings@^2, while @privy-io/react-auth pulls in v8 through
# @solana/kit. npm treats that as a hard conflict even though the peer is
# optional and only needed for Circle's Solana features, which this app does
# not use.
#
# Setting it here rather than relying on a --legacy-peer-deps flag means local,
# CI and Vercel all resolve identically. npm reads the project .npmrc next to
# package.json, so this file must stay in the same directory as package.json —
# at the repository root it is silently ignored.
legacy-peer-deps=true
