# Documentation only; the application does not automatically load this file.
ALPHALITMUS_COMMIT=local-dev
ALPHALITMUS_ENV=development
ALPHALITMUS_ENABLE_NEXUS=false
ALPHALITMUS_ENABLE_LIVE_NEXUS=false
ALPHALITMUS_ENABLE_NEXUS_BACKTEST=false
# Inject a strategy-bound key externally. Never put a real key in this file.
NEXUS_API_KEY=
NEXUS_API_KEY_FILE=
# Production: ALPHALITMUS_ENV=production and an actual nonzero lowercase 40-hex commit.
# commit_reviewable is syntax only, not Git/build attestation; false pairs only with local-dev.
# Nexus reads: ALPHALITMUS_ENABLE_NEXUS=true only behind an authenticated, rate-limiting TLS proxy.
# Fixed live Candidate v1: use ALPHALITMUS_ENABLE_LIVE_NEXUS=true with a Docker-secret file.
# Compute: BOTH enable switches must equal true, with NEXUS_API_KEY injected externally,
# and each request must contain the JSON boolean confirm_compute: true.
# Compute submits remote backtests, never trades; it is not read-only or idempotent.
# Require explicit compute quotas and a gateway-wide limit across workers/processes.
# No real key is needed for synthetic demos, fixture tests, or documentation review.
