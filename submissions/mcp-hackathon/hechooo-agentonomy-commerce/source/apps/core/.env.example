AUTHORIZATION_SERVICE_HOST=127.0.0.1
AUTHORIZATION_SERVICE_PORT=8013
POLICY_SERVICE_HOST=127.0.0.1
POLICY_SERVICE_PORT=8015
ACTION_SERVICE_HOST=127.0.0.1
ACTION_SERVICE_PORT=8016
AUDIT_SERVICE_HOST=127.0.0.1
AUDIT_SERVICE_PORT=8017
FUNDING_SERVICE_HOST=127.0.0.1
FUNDING_SERVICE_PORT=8018
ACCOUNT_SERVICE_HOST=127.0.0.1
ACCOUNT_SERVICE_PORT=8019

# Public browser origin for account links. Use an HTTPS reverse-proxy URL in production.
CLINK_ACCOUNT_PUBLIC_BASE_URL=http://127.0.0.1:8019
CLINK_ACCOUNT_SESSION_TTL_SECONDS=900
CLINK_ACCOUNT_ALLOWED_PRODUCTS=prediction_markets,marketplace
CLINK_ACCOUNT_DOMAIN=account.clink.local

# Internal account-to-audit service URL. Keep this on the private Core network.
CLINK_AUDIT_SERVICE_URL=http://127.0.0.1:8017
CLINK_CORE_INTERNAL_API_TOKEN=replace-with-a-long-random-secret
# Generate independently with `openssl rand -hex 32`; never reuse the internal API token.
CLINK_RECEIPT_SIGNING_KEY=
# Personal is the default. Server requires a private Redis endpoint shared by all
# Core workers; credentials belong only in the runtime secret manager.
CLINK_PROFILE=personal
CLINK_REDIS_URL=
# Hard maximum: 5 seconds.
CLINK_REDIS_OPERATION_TIMEOUT_SECONDS=1
CLINK_FUNDING_DATABASE_URL=postgresql+psycopg://clink:clink-local-only@127.0.0.1:5433/clink_core
CLINK_NATIVE_MIN_CONFIRMATIONS=1
CLINK_PAYMENT_RECONCILIATION_MAX_ATTEMPTS=12
CLINK_PAYMENT_RECONCILIATION_MAX_AGE_SECONDS=3600

# MistTrack supplies address-risk facts; Core remains the only decision authority.
# Safe defaults keep evaluation in Shadow and all live funding disabled.
CLINK_RISK_PROVIDER=misttrack
CLINK_RISK_MODE=shadow
MISTTRACK_API_KEY=
MISTTRACK_BASE_URL=https://openapi.misttrack.io
# Hard maximum: 30 seconds.
MISTTRACK_TIMEOUT_SECONDS=5
# Hard maximum: 5 attempts.
MISTTRACK_MAX_ATTEMPTS=2
# Required together, with CLINK_REDIS_URL, when Server Profile configures
# MISTTRACK_API_KEY. Set these from the subscribed quota; Clink has no guessed
# default and rejects values above 1000 requests or a 3600-second window.
MISTTRACK_RATE_LIMIT_REQUESTS_PER_WINDOW=
MISTTRACK_RATE_LIMIT_WINDOW_SECONDS=
CLINK_RISK_HOLD_SCORE=31
CLINK_RISK_DENY_SCORE=71
CLINK_RISK_MAX_AGE_SECONDS=300
# Hard maximum: 86400 seconds.
CLINK_RISK_CACHE_TTL_SECONDS=300
# Comma-separated canonical EVM addresses. Denylist always wins; a non-empty
# allowlist restricts all live fundable destinations.
CLINK_FUNDING_DESTINATION_DENYLIST=
CLINK_FUNDING_DESTINATION_ALLOWLIST=

AUTHORIZATION_MCP_HOST=127.0.0.1
AUTHORIZATION_MCP_PORT=9013
POLICY_MCP_HOST=127.0.0.1
POLICY_MCP_PORT=9015
ACTION_MCP_HOST=127.0.0.1
ACTION_MCP_PORT=9016
AUDIT_MCP_HOST=127.0.0.1
AUDIT_MCP_PORT=9017
FUNDING_MCP_HOST=127.0.0.1
FUNDING_MCP_PORT=9018

AUTHORIZATION_SESSION_FILE=services/authorization_service/authorizations.jsonl
# Legacy migration/import inputs only. Action and Policy runtime authority is
# the shared CLINK_FUNDING_DATABASE_URL; they never append JSONL records.
POLICY_DECISION_FILE=services/policy_service/policy_decisions.jsonl
ACTION_INTENT_FILE=services/action_service/action_intents.jsonl
ACTION_APPROVAL_FILE=services/action_service/action_approvals.jsonl
# Optional legacy read/import sources. New audit events and receipts are stored in PostgreSQL.
AUDIT_EVENT_FILE=services/audit_service/audit_events.jsonl
FUNDING_SESSION_FILE=services/funding_service/funding_records.jsonl

CLINK_LIVE_FUNDING=false

# Production funding: user approves a capped USDC allowance once; Clink Native Facilitator
# spends within that cap through transferFrom and records receipts.
CLINK_NATIVE_FACILITATOR_ENABLED=false
CLINK_POLYGON_RPC_URL=
CLINK_BASE_RPC_URL=
CLINK_POLYGON_USDC_ADDRESS=0x3c499c542cef5e3811e1192ce70d8cc03d5c3359
CLINK_POLYGON_SPENDER_ADDRESS=
CLINK_BASE_USDC_ADDRESS=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
CLINK_BASE_SPENDER_ADDRESS=
CLINK_NATIVE_FACILITATOR_RELAYER_PRIVATE_KEY=
CLINK_NATIVE_FACILITATOR_GAS_LIMIT=140000
# Native readiness fails closed unless every configured spender equals the relayer.
CLINK_FUNDING_SPENDER_ADDRESS=

X402_PAYMENT_NETWORK=eip155:137
X402_PAYMENT_TOKEN=USDC
X402_PAYMENT_TOKEN_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
X402_PAYMENT_TOKEN_NAME=USD Coin
X402_PAYMENT_TOKEN_VERSION=2
X402_PAYMENT_TOKEN_DECIMALS=6
