# Copy this file to .env for a local review run. Keep .env untracked.
# Replace the placeholder with the exact lowercase commit being reviewed.
SOURCE_COMMIT=0000000000000000000000000000000000000000
# Use a new 32+ character printable token for each local run.
AGENTONOMY_API_TOKEN=replace-with-a-local-review-token-at-least-32-chars
# Exact browser origin for the optional public visitor demo. Leave empty to
# disable /demo/session and /demo/v1/*; this local value matches the Compose
# page at http://localhost:8080.
AGENTONOMY_DEMO_ORIGIN=http://localhost:8080
