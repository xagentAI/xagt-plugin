# STUB — no real treasury wallet is configured in this scaffold.
# Set this to the real Signal & Strip USDC-on-Base receiving address before
# any public deployment. Never commit a real address to version control.
SIGNAL_STRIP_TREASURY_WALLET=

# Port for the MCP HTTP server (default 3000)
PORT=3000

# Comma-separated list of allowed Host header values (exact match, port
# included) for the SDK's DNS-rebinding protection. For local dev, keep the
# localhost entries. For public deployment, set this to your real domain(s),
# e.g. ALLOWED_HOSTS=mcp.example.com
ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
