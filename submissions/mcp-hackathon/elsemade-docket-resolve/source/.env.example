# Copy to .env.local for local development. Never commit actual credentials.
PORT=3011
HOST=127.0.0.1
DOCKET_AI_PROVIDER=gemini
DOCKET_AI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DOCKET_AUTH_MODE=off
DOCKET_AUTH_TOKENS=
DOCKET_EVIDENCE_FIXTURE=true
DOCKET_EVIDENCE_ALLOW_HOSTS=
DOCKET_EVIDENCE_REQUIRE_ALLOWLIST=false
DOCKET_PUBLIC_RATE_LIMIT_PER_MINUTE=30
