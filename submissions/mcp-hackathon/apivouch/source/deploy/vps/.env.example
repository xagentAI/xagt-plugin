# Documentation only. Inject secrets from a protected operator environment.
# Never fill this tracked file with secrets. See docs/deployment.md.
PUBLIC_BASE_URL=https://apivouch.example.com
ACME_EMAIL=operator@example.com
# Required: actual lowercase 40-hex reviewed source SHA, not a branch/tag.
GIT_COMMIT=
# Required: generated hex password (URL-safe); persistent DB initialization only.
POSTGRES_PASSWORD=
# Required: canonical base64 of 32 raw Ed25519 private bytes; never PEM.
RECEIPT_SIGNING_PRIVATE_KEY_B64=
