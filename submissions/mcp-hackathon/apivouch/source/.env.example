# Local development example only; production uses deploy/vps and docs/deployment.md.
PROJECT_SLUG=apivouch
GIT_COMMIT=0123456789abcdef0123456789abcdef01234567
# Leave empty locally; production requires the exact HTTPS origin and real SHA.
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:///./apivouch.db
ALLOW_PRIVATE_NETWORK=false
REQUEST_TIMEOUT=10
MAX_RETRIES=1
MAX_REDIRECTS=3
MAX_RESPONSE_BYTES=1048576
MAX_UPLOAD_BYTES=524288
MAX_MCP_REQUEST_BYTES=1048576
MAX_ENDPOINTS=200
MAX_PROJECTS=250
MAX_OUTCOME_RECEIPTS=1000
MAX_PROOF_PAGES=20
MAX_PROOF_RECORDS=5000
CORS_ORIGINS=
REQUIRE_SIGNED_RECEIPTS=false
# Optional environment-only canonical base64 of an Ed25519 raw 32-byte private key.
# Do not put real private keys in this file or source control.
# RECEIPT_SIGNING_PRIVATE_KEY_B64=
# Optional 1-64 ASCII letters/digits/._-, starting with a letter or digit.
# RECEIPT_SIGNING_KEY_ID=
