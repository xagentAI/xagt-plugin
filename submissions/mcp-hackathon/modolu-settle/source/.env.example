# Settle — environment template. Copy to .env.local for local development.
# Never commit .env.local. Never put secrets in NEXT_PUBLIC_* variables.
# Chain ID, USDC contract, decimals, confirmation defaults, expiry and body
# limits are code constants and are intentionally NOT configurable here.

# ---- Milestone 0: health + X-Agent verification -----------------------------

# Registered X-Agent hackathon slug. Required in production and must be exactly
# this value; the verification route returns 500 (never fabricated data) while
# it is missing or different.
XAGENT_SLUG=modolu-settle

# Structured log threshold: debug | info | warn | error | silent. Default: info.
LOG_LEVEL=info

# Platform-provided by Vercel; do not set in deployed environments.
# Set VERCEL_GIT_COMMIT_SHA locally only to exercise the verification route
# (it must be the exact 40-character lowercase commit SHA).
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=

# ---- Milestone 1: persistence + chain provider (all required) ---------------
# Validated at startup of the first request; the app refuses to serve without them.

# Neon pooled connection string (postgres:// or postgresql://) used at runtime.
DATABASE_URL=

# Neon direct (unpooled) connection string used only by `pnpm db:migrate`.
DATABASE_URL_UNPOOLED=

# Alchemy Base mainnet RPC URL (https://). Server-only; contains the provider
# credential and must never be logged or exposed through NEXT_PUBLIC_*.
ALCHEMY_BASE_RPC_URL=

# ---- Tests ------------------------------------------------------------------
# Optional. When set, tests/integration runs the migration and repository
# tests against this dedicated test database (never production).
# TEST_DATABASE_URL=
