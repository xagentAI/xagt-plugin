# ═════════════════════════════════════════════
# Multipu - Environment Configuration Template
# ═════════════════════════════════════════════

# Session Security (Generate a random 32+ character string)
SESSION_SECRET=your-secure-session-secret-at-least-32-chars-long

# Solana Configuration
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_APP_PHASE=testnet
NEXT_PUBLIC_ENABLE_MAINNET_LAUNCHES=false
ENABLE_MAINNET_LAUNCHES=false

# EVM / BSC Configuration
ENABLE_EVM_LAUNCH_ADAPTERS=false
NEXT_PUBLIC_ENABLE_EVM_LAUNCH_ADAPTERS=false
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Supabase (Database & State)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Multipu AI Engine (Groq Cloud)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

